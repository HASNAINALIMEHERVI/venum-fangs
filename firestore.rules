rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    function validCustomerOrder(orderId) {
      let order = request.resource.data;
      return order.keys().hasOnly([
          'id', 'date', 'customer', 'items', 'total', 'subtotal',
          'shippingCost', 'discountApplied', 'appliedPromoCode',
          'paymentMethod', 'notes', 'status'
        ])
        && order.keys().hasAll([
          'id', 'date', 'customer', 'items', 'total', 'subtotal',
          'shippingCost', 'discountApplied', 'appliedPromoCode',
          'paymentMethod', 'notes', 'status'
        ])
        && order.id == orderId
        && orderId.matches('^BL-[0-9]{8}-[0-9]{3}$')
        && order.date is string && order.date.size() <= 40
        && order.customer is map
        && order.customer.email is string && order.customer.email.size() <= 254
        && order.customer.phone is string && order.customer.phone.size() <= 30
        && order.customer.firstName is string && order.customer.firstName.size() <= 80
        && order.customer.address is string && order.customer.address.size() <= 300
        && order.customer.city is string && order.customer.city.size() <= 100
        && order.items is list && order.items.size() > 0 && order.items.size() <= 20
        && order.subtotal is number && order.subtotal >= 0 && order.subtotal <= 10000000
        && order.shippingCost in [0, 299]
        && order.discountApplied is number && order.discountApplied >= 0
        && order.discountApplied <= order.subtotal + order.shippingCost + 10000
        && order.total is number && order.total >= 0
        && ((order.discountApplied <= order.subtotal + order.shippingCost
             && order.total == order.subtotal + order.shippingCost - order.discountApplied)
            || (order.discountApplied > order.subtotal + order.shippingCost && order.total == 0))
        && (order.appliedPromoCode == null || order.appliedPromoCode is string)
        && order.paymentMethod in ['cod', 'easypaisa']
        && order.notes is string && order.notes.size() <= 1000
        && order.status == 'PENDING';
    }

    match /orders/{orderId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.customer.email == request.auth.token.email);
      allow list: if isAdmin();
      allow create: if validCustomerOrder(orderId);
      allow update, delete: if isAdmin();
    }
    match /products/{productId} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{categoryId} { allow read: if true; allow write: if isAdmin(); }
    match /promocodes/{codeId} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /launches/{launchId} { allow read: if true; allow write: if isAdmin(); }
    match /carts/{userId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    match /profiles/{userId} { allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId; }
    match /restock_notifications/{docId} { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /subscribers/{docId} { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /newsletter_subscribers/{docId} { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /admins/{userId} { allow read: if isSignedIn(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
